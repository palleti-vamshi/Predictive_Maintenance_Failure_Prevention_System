{
  "expo": {
    "name": "Predictive Maintenance",
    "slug": "predictive-maintenance-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1120",
    "splash": {
      "backgroundColor": "#0b1120",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1120"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}

