# Backend API base endpoint for React Native Expo client
# Run `ipconfig getifaddr en0` to find your Mac's current Wi-Fi LAN IP
# Physical Device (Expo Go / Same Wi-Fi): http://<YOUR_MAC_LAN_IP>:5001/api (e.g. http://192.168.137.189:5001/api)
# iOS Simulator: http://localhost:5001/api
# Android Emulator: http://10.0.2.2:5001/api
EXPO_PUBLIC_API_BASE_URL=http://192.168.137.189:5001/api
