# Server Port
PORT=5001

# Node Environment: development | test | production
NODE_ENV=development

# MongoDB Connection String (e.g. mongodb://localhost:27017/predictive_maintenance)
# If unavailable, server starts in disconnected database mode without crashing.
MONGODB_URI=mongodb://localhost:27017/predictive_maintenance

# Local storage directory for uploaded raw dataset files (CSV)
FILE_STORAGE_DIR=./uploads

# CORS Allowed Origin for client web application
CORS_ORIGIN=http://localhost:5173

# Demo Account Passwords (Overrides defaults for seed script and test suite)
# DEMO_MANAGER_PASSWORD=YourSecureDevPassword123!
# DEMO_TECH_PASSWORD=YourSecureDevPassword123!
# DEMO_VIEWER_PASSWORD=YourSecureDevPassword123!

